<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IMMATCH — Une solution Cadre Estate Solutions</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400;1,9..40,500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --teal: #0F8191;
    --teal-light: #1aa3b5;
    --teal-pale: #e1f5f7;
    --teal-deep: #085060;
    --ink: #1a1a18;
    --ink-soft: #33332e;
    --stone: #f4f2ed;
    --stone-mid: #e8e5de;
    --stone-dark: #c8c4bb;
    --white: #fdfcfa;
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans: 'DM Sans', system-ui, sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--sans);
    background: var(--white);
    color: var(--ink);
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* NAV */
  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 40px;
    width: 100%;
  }

  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 40px;
    background: rgba(253,252,250,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--stone-mid);
  }
  .nav-brand { display: flex; flex-direction: column; }
  .nav-wordmark {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: .04em;
    color: var(--ink);
  }
  .nav-sub {
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--teal);
    font-weight: 400;
    margin-top: 1px;
  }
  .nav-links {
    display: flex; gap: 36px; align-items: center;
    font-size: 13px; color: var(--ink-soft); letter-spacing: .02em;
  }
  .nav-links a { text-decoration: none; color: inherit; transition: color .2s; }
  .nav-links a:hover { color: var(--teal); }
  .nav-right { display: flex; gap: 12px; align-items: center; }
  .btn-ghost {
    font-family: var(--sans); font-size: 13px; font-weight: 400;
    color: var(--ink-soft); background: none; border: none; cursor: pointer;
    letter-spacing: .02em; padding: 8px 16px;
  }
  .btn-primary {
    font-family: var(--sans); font-size: 13px; font-weight: 500;
    background: var(--teal); color: #fff; border: none; cursor: pointer;
    padding: 10px 22px; border-radius: 100px; letter-spacing: .03em;
    transition: background .2s, transform .15s;
  }
  .btn-primary:hover { background: var(--teal-deep); transform: translateY(-1px); }

  /* HERO */
  .hero {
    min-height: 100vh;
    padding-top: 80px;
    overflow: hidden;
  }
  .hero-left {
    display: flex; flex-direction: column; justify-content: center;
    align-items: center; text-align: center;
    padding: 60px 24px;
  }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--teal); margin-bottom: 32px; font-weight: 500;
    justify-content: center;
  }
  .hero-eyebrow::before {
    content: ''; display: block; width: 28px; height: 1px; background: var(--teal);
  }
  .hero-title {
    font-family: var(--serif);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -.01em;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .hero-title em {
    font-style: italic;
    color: var(--teal);
  }
  .hero-subtitle {
    font-family: var(--serif);
    font-size: clamp(17px, 2vw, 22px);
    font-weight: 300;
    color: var(--ink-soft);
    line-height: 1.5;
    margin-bottom: 40px;
    max-width: 500px;
  }
  .hero-actions { display: flex; gap: 16px; align-items: center; justify-content: center; margin-bottom: 64px; }
  .btn-hero {
    font-family: var(--sans); font-size: 14px; font-weight: 500;
    background: var(--ink); color: #fff; border: none; cursor: pointer;
    padding: 14px 32px; border-radius: 100px; letter-spacing: .03em;
    transition: background .2s, transform .15s; display: flex; align-items: center; gap: 8px;
  }
  .btn-hero:hover { background: var(--teal); transform: translateY(-1px); }
  .btn-hero-ghost {
    font-family: var(--sans); font-size: 14px; font-weight: 400;
    background: none; color: var(--ink-soft); border: 1px solid var(--stone-dark);
    cursor: pointer; padding: 13px 28px; border-radius: 100px; letter-spacing: .03em;
    transition: border-color .2s, color .2s;
  }
  .btn-hero-ghost:hover { border-color: var(--teal); color: var(--teal); }
  .hero-proof {
    display: flex; gap: 32px; align-items: center; justify-content: center;
    padding-top: 32px;
    border-top: 1px solid var(--stone-mid);
    width: 100%;
  }
  .proof-item { display: flex; flex-direction: column; gap: 2px; align-items: center; text-align: center; }
  .proof-num {
    font-family: var(--serif); font-size: 28px; font-weight: 600; color: var(--teal);
    line-height: 1;
  }
  .proof-label { font-size: 11px; color: var(--ink-soft); letter-spacing: .05em; }

  /* HERO RIGHT — Illustration immersive */
  .hero-right {
    position: relative;
    background: var(--stone);
    overflow: hidden;
  }
  .hero-right::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 60px,
      rgba(15,129,145,0.03) 60px,
      rgba(15,129,145,0.03) 61px
    );
  }
  .hero-card-stack {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 340px;
  }
  .match-card {
    background: var(--white);
    border: 1px solid var(--stone-mid);
    border-radius: 16px;
    padding: 20px 24px;
    margin-bottom: 12px;
    box-shadow: 0 4px 20px rgba(26,26,24,0.06);
    transition: transform .3s ease;
    animation: floatIn .6s ease both;
  }
  .match-card:nth-child(1) { animation-delay: 0s; transform: rotate(-1deg); }
  .match-card:nth-child(2) { animation-delay: .15s; transform: rotate(.5deg); }
  .match-card:nth-child(3) { animation-delay: .3s; transform: rotate(-0.5deg); }
  .match-card:hover { transform: rotate(0) translateY(-4px); }

  @keyframes floatIn {
    from { opacity: 0; transform: translateY(20px) rotate(var(--r, 0deg)); }
    to { opacity: 1; }
  }

  .card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
  .card-badge {
    font-size: 10px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 100px;
  }
  .badge-match { background: var(--teal-pale); color: var(--teal-deep); }
  .badge-new { background: #f0fdf4; color: #166534; }
  .score-ring {
    width: 44px; height: 44px; border-radius: 50%;
    border: 2px solid var(--teal);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--serif); font-size: 15px; font-weight: 600; color: var(--teal);
  }
  .card-body { font-size: 13px; color: var(--ink-soft); line-height: 1.65; margin-bottom: 12px; }
  .card-body strong { color: var(--ink); font-weight: 500; }
  .card-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .tag {
    font-size: 11px; color: var(--ink-soft);
    background: var(--stone); padding: 3px 10px; border-radius: 100px;
    border: 1px solid var(--stone-mid);
  }

  /* PILLIERS */
  .pillars {
    padding: 100px 0;
    background: var(--ink);
    color: var(--white);
  }
  .pillars-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 72px;
  }
  .pillars-title {
    font-family: var(--serif);
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 300; line-height: 1.1;
    max-width: 520px;
  }
  .pillars-title em { font-style: italic; color: var(--teal-light); }
  .pillars-lead {
    max-width: 280px;
    font-size: 14px;
    color: rgba(253,252,250,.55);
    line-height: 1.7;
    text-align: right;
  }
  .pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(255,255,255,.08); }
  .pillar {
    background: var(--ink);
    padding: 48px 40px;
    transition: background .25s;
  }
  .pillar:hover { background: #222220; }
  .pillar-num {
    font-family: var(--serif);
    font-size: 48px; font-weight: 300;
    color: var(--teal-light);
    opacity: .4;
    line-height: 1; margin-bottom: 24px;
  }
  .pillar-title {
    font-family: var(--serif); font-size: 24px; font-weight: 400;
    color: var(--white); margin-bottom: 12px; line-height: 1.2;
  }
  .pillar-body { font-size: 15px; color: rgba(253,252,250,.65); line-height: 1.8; }

  /* PROCESS */
  .process {
    padding: 100px 0;
    background: var(--white);
  }
  .section-eyebrow {
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--teal); font-weight: 500;
    display: flex; align-items: center; gap: 10px; margin-bottom: 24px;
  }
  .section-eyebrow::before { content: ''; display: block; width: 24px; height: 1px; background: var(--teal); }
  .process-title {
    font-family: var(--serif); font-size: clamp(36px, 4vw, 54px);
    font-weight: 300; line-height: 1.1; max-width: 560px; margin-bottom: 80px;
  }
  .process-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }
  .step { position: relative; }
  .step::after {
    content: '→'; position: absolute; top: 28px; right: -24px;
    font-size: 18px; color: var(--stone-dark); font-family: var(--serif);
  }
  .step:last-child::after { display: none; }
  .step-num {
    font-family: var(--serif); font-size: 64px; font-weight: 300;
    color: var(--stone-mid); line-height: 1; margin-bottom: 24px;
  }
  .step-title {
    font-family: var(--serif); font-size: 22px; font-weight: 400;
    margin-bottom: 12px; color: var(--ink);
  }
  .step-body { font-size: 15px; color: var(--ink-soft); line-height: 1.8; }

  /* PROFILS */
  .profiles {
    padding: 0 0 100px;
    background: var(--white);
  }
  .profiles-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .profile-card {
    border: 1px solid var(--stone-mid); border-radius: 20px;
    padding: 48px;
    position: relative; overflow: hidden;
    transition: border-color .25s, transform .25s;
    cursor: pointer;
  }
  .profile-card:hover { border-color: var(--teal); transform: translateY(-4px); }
  .profile-card.featured {
    background: var(--teal);
    border-color: var(--teal);
    color: #fff;
  }
  .profile-eyebrow {
    font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--teal); font-weight: 500; margin-bottom: 16px;
  }
  .profile-card.featured .profile-eyebrow { color: rgba(255,255,255,.7); }
  .profile-title {
    font-family: var(--serif); font-size: 28px; font-weight: 400;
    margin-bottom: 16px; line-height: 1.2;
  }
  .profile-body { font-size: 15px; color: var(--ink-soft); line-height: 1.8; margin-bottom: 32px; }
  .profile-card.featured .profile-body { color: rgba(255,255,255,.75); }
  .profile-list { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; }
  .profile-list li {
    font-size: 13px; color: var(--ink-soft);
    display: flex; align-items: center; gap: 8px;
  }
  .profile-card.featured .profile-list li { color: rgba(255,255,255,.8); }
  .profile-list li::before {
    content: ''; display: block; width: 4px; height: 4px;
    background: var(--teal); border-radius: 50%; flex-shrink: 0;
  }
  .profile-card.featured .profile-list li::before { background: rgba(255,255,255,.6); }
  .profile-cta {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 500; color: var(--teal);
    text-decoration: none;
    transition: gap .2s;
  }
  .profile-cta:hover { gap: 14px; }
  .profile-card.featured .profile-cta { color: #fff; }

  /* CONFIANCE */
  .trust {
    padding: 100px 0;
    background: var(--stone);
  }
  .trust-left {}
  .trust-title {
    font-family: var(--serif); font-size: clamp(32px, 3.5vw, 48px);
    font-weight: 300; line-height: 1.1; margin-bottom: 24px;
  }
  .trust-title em { font-style: italic; color: var(--teal); }
  .trust-body { font-size: 15px; color: var(--ink-soft); line-height: 1.8; margin-bottom: 40px; }
  .trust-right { display: flex; flex-direction: column; gap: 24px; }
  .trust-item {
    background: var(--white); border-radius: 16px;
    padding: 28px 32px;
    border: 1px solid var(--stone-mid);
  }
  .trust-item-title {
    font-family: var(--serif); font-size: 18px; font-weight: 400;
    margin-bottom: 8px; display: flex; align-items: center; gap: 10px;
  }
  .trust-dot { width: 6px; height: 6px; background: var(--teal); border-radius: 50%; flex-shrink: 0; }
  .trust-item-body { font-size: 15px; color: var(--ink-soft); line-height: 1.75; }

  /* CTA FINAL */
  .cta-final {
    padding: 120px 0;
    background: var(--white);
    text-align: center;
  }
  .cta-final-eyebrow {
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--teal); font-weight: 500; margin-bottom: 24px;
    display: flex; align-items: center; justify-content: center; gap: 10px;
  }
  .cta-final-eyebrow::before,
  .cta-final-eyebrow::after { content: ''; display: block; width: 24px; height: 1px; background: var(--teal); }
  .cta-final-title {
    font-family: var(--serif); font-size: clamp(40px, 5vw, 72px);
    font-weight: 300; line-height: 1.05; max-width: 700px; margin: 0 auto 24px;
  }
  .cta-final-title em { font-style: italic; color: var(--teal); }
  .cta-final-sub { font-size: 15px; color: var(--ink-soft); margin-bottom: 48px; }
  .cta-final-actions { display: flex; gap: 16px; justify-content: center; }

  /* FOOTER */
  footer {
    background: var(--ink); color: rgba(253,252,250,.5);
    padding: 64px 0 40px;
  }
  .footer-top {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 48px; padding-bottom: 48px;
    border-bottom: 1px solid rgba(255,255,255,.08);
    margin-bottom: 32px;
  }
  .footer-brand .nav-wordmark { color: var(--white); margin-bottom: 4px; }
  .footer-brand .nav-sub { color: var(--teal-light); }
  .footer-brand p { font-size: 12px; margin-top: 16px; line-height: 1.6; max-width: 220px; }
  .footer-col h4 {
    font-size: 10px; letter-spacing: .12em; text-transform: uppercase;
    color: rgba(253,252,250,.35); font-weight: 500; margin-bottom: 16px;
  }
  .footer-col a {
    display: block; font-size: 12px; color: rgba(253,252,250,.5);
    text-decoration: none; margin-bottom: 8px; transition: color .2s;
  }
  .footer-col a:hover { color: var(--teal-light); }
  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 11px; color: rgba(253,252,250,.3);
  }
  .status-dot { display: flex; align-items: center; gap: 6px; }
  .dot-green { width: 6px; height: 6px; background: #4ade80; border-radius: 50%; }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 1024px) {
    .hero > div { grid-template-columns: 1fr !important; min-height: auto !important; }
    .hero-left { padding: 48px 0 32px !important; }
    .hero-right { display: none; }
    .pillars-header { flex-direction: column; gap: 24px; }
    .pillars-header .pillars-lead { text-align: left; max-width: 100%; }
    .pillars-grid { grid-template-columns: 1fr !important; }
    .pillar { padding: 32px 24px; }
    .process-steps { grid-template-columns: 1fr !important; gap: 32px; }
    .step::after { display: none; }
    .profiles-grid { grid-template-columns: 1fr !important; }
    .trust > div { grid-template-columns: 1fr !important; gap: 40px !important; }
    .footer-top { grid-template-columns: 1fr 1fr !important; gap: 32px !important; }
    .footer-bottom { flex-direction: column; gap: 8px; text-align: center; }
    #estimer > div > div { grid-template-columns: 1fr !important; gap: 40px !important; }
  }

  @media (max-width: 768px) {
    nav > div { flex-wrap: wrap; gap: 12px; }
    .nav-links { display: none; }
    .hero-title { font-size: clamp(32px, 8vw, 48px) !important; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .btn-hero, .btn-hero-ghost { text-align: center; justify-content: center; }
    .pillars-title { font-size: clamp(28px, 6vw, 40px) !important; }
    .process-title { font-size: clamp(28px, 6vw, 40px) !important; }
    .trust-title { font-size: clamp(28px, 6vw, 40px) !important; }
    .cta-final-title { font-size: clamp(32px, 8vw, 56px) !important; }
    .profile-card { padding: 32px 24px; }
    .footer-top { grid-template-columns: 1fr !important; }
    section { padding-left: 20px !important; padding-right: 20px !important; }
    .hero { padding-top: 72px; }
    .hero > div { padding: 0 20px !important; }
  }

  @media (max-width: 480px) {
    .hero-proof { flex-direction: column; gap: 16px; }
    .hero-title { font-size: 32px !important; }
    .cta-final-actions { flex-direction: column; }
    .cta-final-actions .btn-hero, .cta-final-actions .btn-hero-ghost { width: 100%; text-align: center; justify-content: center; }
  }

  /* ========== EXTENSIONS V5 — sections conversion (AJOUT, ne modifie rien) ========== */
  .x-section { padding: 100px 0; }
  .x-wrap { max-width: 1160px; margin: 0 auto; padding: 0 40px; width: 100%; }
  .x-eyebrow {
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--teal); font-weight: 500;
    display: flex; align-items: center; gap: 10px; margin-bottom: 24px;
  }
  .x-eyebrow::before { content:''; display:block; width:24px; height:1px; background: var(--teal); }
  .x-title {
    font-family: var(--serif); font-size: clamp(32px, 4vw, 52px);
    font-weight: 300; line-height: 1.1; letter-spacing: -.01em;
    color: var(--ink); max-width: 660px;
  }
  .x-title em { font-style: italic; color: var(--teal); }
  .x-lead { font-size: 16px; color: var(--ink-soft); line-height: 1.8; max-width: 600px; margin-top: 20px; }
  .x-lead b { color: var(--ink); font-weight: 500; }

  /* N1 — ce que fait immatch */
  .x-what-grid { display:grid; grid-template-columns: repeat(3,1fr); gap:1px; background:var(--stone-mid); border:1px solid var(--stone-mid); border-radius:20px; overflow:hidden; margin-top:48px; }
  .x-what-cell { background:var(--white); padding:36px 32px; }
  .x-what-step { font-family:var(--serif); font-size:14px; color:var(--teal); font-weight:600; letter-spacing:.06em; margin-bottom:14px; }
  .x-what-cell h3 { font-family:var(--serif); font-size:21px; font-weight:400; color:var(--ink); margin-bottom:10px; line-height:1.25; }
  .x-what-cell p { font-size:14px; color:var(--ink-soft); line-height:1.7; }
  .x-not { display:flex; flex-wrap:wrap; gap:12px; margin-top:32px; }
  .x-not span { font-size:13px; color:var(--ink-soft); background:var(--white); border:1px solid var(--stone-mid); border-radius:100px; padding:8px 18px; }
  .x-not span b { color:var(--ink); font-weight:500; }

  /* N2 — vs portails */
  .x-vs { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:56px; }
  .x-vs-card { border-radius:20px; padding:40px; border:1px solid var(--stone-mid); }
  .x-vs-card.is-noise { background:var(--stone); }
  .x-vs-card.is-precision { background:var(--teal); color:#fff; border-color:var(--teal); }
  .x-vs-tag { font-size:11px; letter-spacing:.12em; text-transform:uppercase; font-weight:600; margin-bottom:18px; }
  .x-vs-card.is-noise .x-vs-tag { color:var(--ink-soft); }
  .x-vs-card.is-precision .x-vs-tag { color:rgba(255,255,255,.75); }
  .x-vs-card h3 { font-family:var(--serif); font-size:25px; font-weight:400; line-height:1.2; margin-bottom:8px; }
  .x-vs-card p { font-size:14px; line-height:1.7; margin-top:4px; }
  .x-vs-card.is-noise p { color:var(--ink-soft); }
  .x-vs-card.is-precision p { color:rgba(255,255,255,.85); }
  .x-noise-grid { display:grid; grid-template-columns:repeat(12,1fr); gap:5px; margin:22px 0; -webkit-mask-image:linear-gradient(to bottom,#000 28%,transparent 100%); mask-image:linear-gradient(to bottom,#000 28%,transparent 100%); }
  .x-noise-grid i { aspect-ratio:1; background:var(--stone-dark); opacity:.45; border-radius:2px; }
  .x-precision-stack { display:flex; flex-direction:column; gap:8px; margin:22px 0; }
  .x-precision-stack i { background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.28); border-radius:10px; padding:11px 16px; font-style:normal; color:#fff; display:flex; justify-content:space-between; align-items:center; gap:12px; }
  .x-precision-stack i span { font-size:13px; }
  .x-precision-stack i b { font-family:var(--serif); font-weight:600; font-size:15px; font-style:italic; white-space:nowrap; }

  /* N3 — off-market / pas d'annonce publique */
  .x-split { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; }

  /* N4 — exemple concret */
  .x-ex-grid { display:grid; grid-template-columns:1fr auto 1fr; gap:32px; align-items:center; margin-top:56px; }
  .x-ex-card { border:1px solid var(--stone-mid); border-radius:18px; padding:32px; background:var(--white); }
  .x-ex-role { font-size:11px; letter-spacing:.1em; text-transform:uppercase; font-weight:600; margin-bottom:12px; }
  .x-ex-name { font-family:var(--serif); font-size:23px; color:var(--ink); margin-bottom:8px; }
  .x-ex-card p { font-size:14px; color:var(--ink-soft); line-height:1.7; }
  .x-ex-ring { width:86px; height:86px; border-radius:50%; border:2px solid var(--teal); display:flex; align-items:center; justify-content:center; font-family:var(--serif); font-size:27px; font-weight:600; color:var(--teal); margin:0 auto; }
  .x-ex-outcome { margin-top:40px; background:var(--teal-pale); border:1px solid rgba(15,129,145,.15); border-radius:16px; padding:28px 32px; }
  .x-ex-outcome p { font-size:15px; color:var(--teal-deep); line-height:1.8; }

  /* N5 — avantages concrets */
  .x-adv-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:24px; margin-top:48px; }
  .x-adv-card { background:var(--white); border:1px solid var(--stone-mid); border-radius:16px; padding:32px; transition:border-color .25s, transform .25s; }
  .x-adv-card:hover { border-color:var(--teal); transform:translateY(-3px); }
  .x-adv-idx { font-family:var(--serif); font-size:15px; color:var(--teal); font-weight:600; letter-spacing:.06em; margin-bottom:16px; }
  .x-adv-card h3 { font-family:var(--serif); font-size:21px; font-weight:400; color:var(--ink); margin-bottom:10px; line-height:1.25; }
  .x-adv-card p { font-size:14px; color:var(--ink-soft); line-height:1.7; }

  /* N6 — early adopter */
  .x-early { display:flex; align-items:center; justify-content:space-between; gap:56px; }
  .x-early-btn-wrap { flex-shrink:0; text-align:center; }

  /* Responsive additif */
  @media (max-width: 960px) {
    .x-what-grid { grid-template-columns:1fr; }
    .x-vs { grid-template-columns:1fr; }
    .x-split { grid-template-columns:1fr; gap:40px; }
    .x-ex-grid { grid-template-columns:1fr; gap:20px; }
    .x-ex-ring { margin:4px auto; }
    .x-early { flex-direction:column; align-items:flex-start; gap:32px; }
    .x-early-btn-wrap { text-align:left; }
  }
  @media (max-width: 560px) {
    .x-section { padding:64px 0; }
    .x-wrap { padding:0 20px; }
    .x-adv-grid { grid-template-columns:1fr; }
    .x-noise-grid { grid-template-columns:repeat(8,1fr); }
    .x-vs-card, .x-adv-card, .x-ex-card { padding:28px 22px; }
  }


  /* ===== HERO v6 — clair, structure GPT, identite IMMATCH ===== */
  .x6-hero { background: var(--stone); border-bottom:1px solid var(--stone-mid); }
  .x6-hero-wrap { max-width:1160px; margin:0 auto; padding:72px 40px 80px; display:grid; grid-template-columns:1.05fr .95fr; gap:64px; align-items:center; }
  .x6-eyebrow { display:inline-flex; align-items:center; gap:9px; font-family:var(--sans); font-size:12px; font-weight:500; color:var(--teal-deep); background:var(--white); border:1px solid var(--stone-mid); padding:8px 16px; border-radius:100px; margin-bottom:28px; }
  .x6-dot { width:7px; height:7px; border-radius:50%; background:#B8952A; }
  .x6-h1 { font-family:var(--serif); font-size:clamp(40px,5.2vw,68px); font-weight:600; line-height:1.04; letter-spacing:-.015em; color:var(--ink); margin:0 0 24px; }
  .x6-h1 em { font-style:italic; color:var(--teal); }
  .x6-sub { font-family:var(--sans); font-size:18px; line-height:1.65; color:var(--ink-soft); max-width:480px; margin:0 0 32px; }
  .x6-actions { display:flex; gap:14px; flex-wrap:wrap; align-items:center; margin-bottom:18px; }
  .x6-note { font-size:13px; color:var(--ink-soft); opacity:.85; margin:0 0 36px; max-width:440px; }
  .x6-proof { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; border-top:1px solid var(--stone-mid); padding-top:28px; }
  .x6-proof-item { display:flex; flex-direction:column; gap:5px; }
  .x6-proof-num { font-family:var(--serif); font-size:30px; font-weight:600; color:var(--teal); line-height:1; }
  .x6-proof-word { font-size:19px; line-height:1.1; }
  .x6-proof-label { font-size:12px; color:var(--ink-soft); line-height:1.35; }

  .x6-device { background:var(--white); border:1px solid var(--stone-mid); border-radius:22px; box-shadow:0 24px 60px -20px rgba(26,26,24,.22); overflow:hidden; }
  .x6-device-head { display:flex; align-items:center; gap:12px; padding:15px 22px; border-bottom:1px solid var(--stone-mid); }
  .x6-dots { display:flex; gap:6px; }
  .x6-dots i { width:9px; height:9px; border-radius:50%; background:var(--stone-dark); display:block; }
  .x6-device-title { margin-left:auto; font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); font-weight:500; }
  .x6-device-body { padding:22px; }
  .x6-device-row { display:flex; justify-content:space-between; align-items:center; gap:10px; margin-bottom:16px; }
  .x6-badge-private { display:inline-flex; align-items:center; gap:6px; font-size:11.5px; font-weight:500; color:var(--teal-deep); background:var(--teal-pale); padding:5px 12px; border-radius:100px; }
  .x6-badge-compat { font-size:12px; font-weight:600; color:#9c7d2e; font-family:var(--serif); white-space:nowrap; }
  .x6-device-photo { aspect-ratio:16/9; border-radius:12px; background:linear-gradient(135deg,var(--teal-pale),var(--stone-mid)); display:flex; align-items:center; justify-content:center; margin-bottom:16px; }
  .x6-device-name { font-family:var(--serif); font-size:22px; font-weight:600; color:var(--ink); margin-bottom:6px; }
  .x6-device-desc { font-size:13px; color:var(--ink-soft); line-height:1.6; margin-bottom:14px; }
  .x6-device-tags { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px; }
  .x6-device-tags span { font-size:12px; color:var(--ink-soft); background:var(--stone); border:1px solid var(--stone-mid); padding:5px 12px; border-radius:100px; }
  .x6-device-consent { background:var(--ink); border-radius:14px; padding:4px 18px; }
  .x6-consent-row { display:flex; justify-content:space-between; align-items:center; gap:10px; padding:11px 0; border-bottom:1px solid rgba(255,255,255,.1); font-size:13px; color:rgba(253,252,250,.7); }
  .x6-consent-row:last-child { border-bottom:none; }
  .x6-consent-row b { color:#fff; font-weight:500; font-size:12.5px; }

  @media (max-width: 940px) {
    .x6-hero-wrap { grid-template-columns:1fr; gap:44px; padding:48px 24px 56px; }
    .x6-proof { grid-template-columns:1fr 1fr; gap:18px; }
  }
  @media (max-width: 520px) {
    .x6-h1 { font-size:clamp(34px,9vw,44px); }
  }


  /* ============ SECTIONS v6 ============ */
  .s6 { padding:96px 0; }
  .s6-wrap { max-width:1160px; margin:0 auto; padding:0 40px; }
  .s6-eyebrow { display:inline-flex;align-items:center;gap:9px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--teal);font-weight:600;margin-bottom:22px; }
  .s6-eyebrow::before { content:'';width:24px;height:1px;background:var(--teal);display:block; }
  .s6-h2 { font-family:var(--serif);font-size:clamp(34px,4.4vw,56px);font-weight:600;line-height:1.05;letter-spacing:-.01em;color:var(--ink);margin:0 0 18px;max-width:820px; }
  .s6-h2 em { font-style:italic;color:var(--teal); }
  .s6-lead { font-size:17px;line-height:1.7;color:var(--ink-soft);max-width:640px;margin:0; }

  .s6-contrast { display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:48px; }
  .s6-cbox { border-radius:20px;padding:34px 36px; }
  .s6-cbox.is-not { background:var(--stone);border:1px solid var(--stone-mid); }
  .s6-cbox.is-yes { background:var(--teal); }
  .s6-cbox h3 { font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;margin:0 0 8px; }
  .s6-cbox.is-not h3 { color:var(--ink-soft); }
  .s6-cbox.is-yes h3 { color:rgba(255,255,255,.7); }
  .s6-cline { display:flex;gap:13px;align-items:flex-start;padding:13px 0;font-size:16px;line-height:1.45; }
  .s6-cbox.is-not .s6-cline { color:var(--ink);border-bottom:1px solid var(--stone-mid); }
  .s6-cbox.is-yes .s6-cline { color:#fff;border-bottom:1px solid rgba(255,255,255,.14); }
  .s6-cline:last-child { border-bottom:none; }
  .s6-ic { width:22px;height:22px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;margin-top:1px;font-size:12px;font-weight:700; }
  .s6-cbox.is-not .s6-ic { background:#ece2da;color:#b06a52; }
  .s6-cbox.is-yes .s6-ic { background:rgba(255,255,255,.22);color:#fff; }

  .s6-change { display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:48px; }
  .s6-change-card { background:var(--white);border:1px solid var(--stone-mid);border-radius:18px;padding:30px 26px; }
  .s6-change-ic { width:46px;height:46px;border-radius:12px;background:var(--teal-pale);display:flex;align-items:center;justify-content:center;margin-bottom:20px; }
  .s6-change-card h3 { font-family:var(--serif);font-size:23px;font-weight:600;color:var(--ink);margin:0 0 10px;line-height:1.2; }
  .s6-change-card p { font-size:16px;line-height:1.6;color:var(--ink-soft);margin:0; }

  .s6-who { display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:48px; }
  .s6-who-card { border:1px solid var(--stone-mid);border-radius:20px;padding:38px;background:var(--white); }
  .s6-who-tag { display:inline-block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;padding:5px 14px;border-radius:100px;margin-bottom:18px; }
  .s6-who-card.is-seller .s6-who-tag { background:#e7f3ee;color:#1D9E75; }
  .s6-who-card.is-buyer .s6-who-tag { background:#e6effa;color:#185FA5; }
  .s6-who-card h3 { font-family:var(--serif);font-size:27px;font-weight:600;color:var(--ink);margin:0 0 12px;line-height:1.18; }
  .s6-who-card > p { font-size:16px;line-height:1.65;color:var(--ink-soft);margin:0 0 20px; }
  .s6-who-list { list-style:none;margin:0;padding:0; }
  .s6-who-list li { display:flex;gap:11px;align-items:flex-start;font-size:16px;color:var(--ink);line-height:1.5;padding:8px 0; }
  .s6-who-list li::before { content:'✓';color:var(--teal);font-weight:700;flex-shrink:0; }

  .s6-steps { display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:48px; }
  .s6-step { background:var(--white);border:1px solid var(--stone-mid);border-radius:18px;padding:30px 26px; }
  .s6-step-num { width:44px;height:44px;border-radius:12px;background:var(--stone);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:18px;font-weight:600;color:var(--teal);margin-bottom:20px; }
  .s6-step h3 { font-family:var(--serif);font-size:21px;font-weight:600;color:var(--ink);margin:0 0 10px;line-height:1.2; }
  .s6-step p { font-size:16px;line-height:1.6;color:var(--ink-soft);margin:0; }

  .s6-ima { display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;margin-top:24px;background:var(--white);border:1px solid var(--stone-mid);border-radius:22px;padding:48px; }
  .s6-ima-badge { display:inline-flex;align-items:center;gap:10px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);font-weight:600;margin-bottom:18px; }
  .s6-ima-badge i { width:28px;height:28px;border-radius:50%;background:var(--teal);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:14px;font-weight:600;color:#fff;font-style:italic;flex-shrink:0; }
  .s6-ima h3 { font-family:var(--serif);font-size:clamp(26px,3vw,38px);font-weight:600;line-height:1.12;color:var(--ink);margin:0 0 16px; }
  .s6-ima h3 em { font-style:italic;color:var(--teal); }
  .s6-ima > div > p { font-size:16px;line-height:1.7;color:var(--ink-soft);margin:0 0 14px; }
  .s6-ima-quote { background:var(--stone);border:1px solid var(--stone-mid);border-radius:18px;padding:34px; }
  .s6-ima-quote .q { font-family:var(--serif);font-size:58px;line-height:.5;color:var(--teal);opacity:.22; }
  .s6-ima-quote p { font-family:var(--sans);font-size:17px;font-weight:400;line-height:1.75;color:#262521;margin:10px 0 0; }
  .s6-ima-quote .sig { margin-top:22px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);font-weight:600; }

  .s6-case { display:grid;grid-template-columns:1fr auto 1fr;gap:28px;align-items:stretch;margin-top:48px; }
  .s6-case-card { border:1px solid var(--stone-mid);border-radius:20px;padding:32px;background:var(--white); }
  .s6-case-role { font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;margin-bottom:12px; }
  .s6-case-name { font-family:var(--serif);font-size:28px;font-weight:600;color:var(--ink);margin-bottom:10px; }
  .s6-case-card p { font-size:16px;line-height:1.6;color:var(--ink-soft);margin:0; }
  .s6-case-mid { display:flex;align-items:center;justify-content:center; }
  .s6-case-badge { background:var(--ink);border-radius:36px;padding:42px 30px;text-align:center;display:flex;flex-direction:column;gap:10px;align-items:center;justify-content:center;min-width:210px;box-shadow:0 18px 44px -22px rgba(26,26,24,.45); }
  .s6-case-badge strong { font-family:var(--serif);font-size:22px;font-weight:600;color:#fff;line-height:1.2; }
  .s6-case-badge span { font-size:12.5px;line-height:1.55;color:rgba(255,255,255,.72);max-width:200px; }
  .s6-case-out { margin-top:28px;background:var(--teal);border-radius:18px;padding:32px 38px; }
  .s6-case-out p { font-size:18px;line-height:1.6;color:#fff;margin:0; }
  .s6-case-out b { font-weight:600; }

  .s6-trust { display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start; }
  .s6-trust-items { display:grid;gap:2px; }
  .s6-titem { padding:20px 0;border-bottom:1px solid var(--stone-mid); }
  .s6-titem:last-child { border-bottom:none; }
  .s6-titem h4 { display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:20px;font-weight:600;color:var(--ink);margin:0 0 6px; }
  .s6-titem h4::before { content:'';width:8px;height:8px;border-radius:50%;background:var(--teal);flex-shrink:0; }
  .s6-titem p { font-size:16px;line-height:1.6;color:var(--ink-soft);margin:0 0 0 18px; }

  .s6-faq { max-width:820px;margin:44px auto 0; }
  .s6-faq details { border-bottom:1px solid var(--stone-mid); }
  .s6-faq summary { cursor:pointer;list-style:none;padding:22px 0;font-family:var(--serif);font-size:21px;font-weight:600;color:var(--ink);display:flex;justify-content:space-between;align-items:center;gap:20px; }
  .s6-faq summary::-webkit-details-marker { display:none; }
  .s6-faq summary::after { content:'+';font-size:26px;color:var(--teal);font-weight:300;flex-shrink:0;line-height:1; }
  .s6-faq details[open] summary::after { content:'\2013'; }
  .s6-faq details p { font-size:16px;line-height:1.7;color:var(--ink-soft);margin:0 0 24px; }

  .s6-cta { background:var(--ink);color:#fff;text-align:center; }
  .s6-cta-eyebrow { display:inline-flex;align-items:center;gap:9px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--teal-light);font-weight:600;margin-bottom:20px; }
  .s6-cta-eyebrow i { width:7px;height:7px;border-radius:50%;background:#B8952A; }
  .s6-cta h2 { font-family:var(--serif);font-size:clamp(38px,5vw,62px);font-weight:600;line-height:1.05;margin:0 auto 18px;max-width:760px; }
  .s6-cta h2 em { font-style:italic;color:var(--teal-light); }
  .s6-cta p { font-size:17px;line-height:1.7;color:rgba(253,252,250,.72);max-width:560px;margin:0 auto 32px; }

  @media (max-width:980px){
    .s6-contrast,.s6-who,.s6-trust,.s6-ima,.s6-case{grid-template-columns:1fr;gap:24px;}
    .s6-change,.s6-steps{grid-template-columns:1fr 1fr;}
    .s6-trust{gap:40px;}
    .s6-ima{gap:32px;padding:32px;}
    .s6-case-mid{flex-direction:row;}
  }
  @media (max-width:560px){
    .s6{padding:60px 0;}
    .s6-wrap{padding:0 20px;}
    .s6-change,.s6-steps{grid-template-columns:1fr;}
    .s6-cbox,.s6-who-card,.s6-step,.s6-change-card,.s6-case-card{padding:24px;}
  }

  .s6-morb { display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:48px; }
  .s6-morb figure { position:relative;margin:0;border-radius:16px;overflow:hidden;aspect-ratio:4/5;border:1px solid var(--stone-mid); }
  .s6-morb img { width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease; }
  .s6-morb figure:hover img { transform:scale(1.04); }
  .s6-morb figcaption { position:absolute;left:18px;bottom:16px;color:#fff;font-family:var(--serif);font-size:22px;font-weight:600;text-shadow:0 2px 12px rgba(0,0,0,.45);letter-spacing:.01em; }
  @media(max-width:780px){ .s6-morb{grid-template-columns:1fr 1fr;} }


  /* CTA final — carte flottante */
  .s6-cta-card { background:var(--ink); border-radius:32px; padding:84px 48px; text-align:center; position:relative; overflow:hidden; box-shadow:0 34px 80px -34px rgba(26,26,24,.55); }
  .s6-cta-card::before { content:''; position:absolute; inset:0; background:radial-gradient(130% 90% at 50% -10%, rgba(15,129,145,.28), transparent 62%); pointer-events:none; }
  .s6-cta-card > * { position:relative; z-index:1; }
  .s6-cta-card h2 { font-family:var(--serif); font-size:clamp(36px,4.6vw,58px); font-weight:600; line-height:1.05; color:#fff; margin:0 auto 18px; max-width:680px; }
  .s6-cta-card h2 em { font-style:italic; color:var(--teal-light); }
  .s6-cta-card p { font-size:17px; line-height:1.7; color:rgba(253,252,250,.74); max-width:540px; margin:0 auto 34px; }
  .s6-cta-btn { display:inline-flex; align-items:center; gap:8px; background:var(--teal); color:#fff; border:none; cursor:pointer; font-family:var(--sans); font-size:15px; font-weight:600; padding:17px 40px; border-radius:100px; letter-spacing:.02em; transition:transform .15s, background .2s; }
  .s6-cta-btn:hover { background:var(--teal-light); transform:translateY(-2px); }
  @media(max-width:560px){ .s6-cta-card{ padding:56px 28px; } }


  .s6-ima-head { display:flex;align-items:center;gap:14px;margin-bottom:24px; }
  .s6-ima-head .dot { width:50px;height:50px;border-radius:50%;background:var(--teal);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:26px;font-weight:600;color:#fff;font-style:italic;flex-shrink:0; }
  .s6-ima-name { font-family:var(--serif);font-size:28px;font-weight:600;color:var(--ink);line-height:1; }
  .s6-ima-role { font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--teal);font-weight:600;margin-top:5px; }
  .s6-ima-quote .sig b { font-size:16px;color:var(--teal);font-weight:600;letter-spacing:0; }

</style>
</head>
<body>
<!-- NAV -->
<nav><div style="max-width:1160px;margin:0 auto;width:100%;display:flex;align-items:center;justify-content:space-between;">
  <div class="nav-brand" style="display:flex;align-items:center;gap:0;">
    <div style="position:relative;width:44px;height:44px;flex-shrink:0;">
      <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
        <rect x="11" y="6" width="22" height="22" rx="2" transform="rotate(45 22 17)" stroke="#B8952A" stroke-width="3" fill="none"/>
      </svg>
    </div>
    <div style="background:var(--teal);border-radius:6px;padding:4px 12px 4px 6px;display:flex;flex-direction:column;justify-content:center;margin-left:-8px;">
      <div style="font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:400;font-style:italic;letter-spacing:.01em;color:#fff;line-height:1.05;">immatch</div>
      <div style="font-size:8px;letter-spacing:.11em;text-transform:uppercase;color:rgba(255,255,255,.75);font-weight:500;margin-top:1px;">by Cadre Estate Solutions</div>
    </div>
  </div>
  <div class="nav-links">
    <a href="#process">Comment ça marche</a>
    <a href="#pour-qui">Pour qui ?</a>
    <a href="#confiance">Confiance</a>
    <a href="#pro">Espace pro</a>
  </div>
  <div class="nav-right">
    <button class="btn-ghost">Connexion</button>
    <button class="btn-primary">Décrivez votre projet</button>
  </div></div>
</nav>
<!-- HERO -->
<section class="x6-hero">
  <div class="x6-hero-wrap">
    <div class="x6-hero-left">
      <div class="x6-eyebrow"><span class="x6-dot"></span>Immobilier hors annonces · confidentialité par défaut</div>
      <h1 class="x6-h1">Vendez ou trouvez un bien immobilier <em>hors annonces</em>, selon vos critères.</h1>
      <p class="x6-sub">Sans diffusion publique, sans partage de vos coordonnées sans accord, et sans contact imposé.</p>
      <div class="x6-actions">
        <button class="btn-hero">Décrivez votre projet →</button>
        <a href="#process" class="btn-hero-ghost">Voir comment ça marche</a>
      </div>
      <p class="x6-note">Les professionnels vérifiés n'apparaissent que sur demande et en cas de besoin réel.</p>
      <div class="x6-proof">
        <div class="x6-proof-item"><span class="x6-proof-num">0</span><span class="x6-proof-label">Diffusion sans accord</span></div>
        <div class="x6-proof-item"><span class="x6-proof-num">0</span><span class="x6-proof-label">Contact imposé</span></div>
        <div class="x6-proof-item"><span class="x6-proof-num x6-proof-word">Accord requis</span><span class="x6-proof-label">pour vos coordonnées</span></div>
        <div class="x6-proof-item"><span class="x6-proof-num x6-proof-word">Sur demande</span><span class="x6-proof-label">pros vérifiés uniquement</span></div>
      </div>
    </div>

    <aside class="x6-hero-right">
      <div class="x6-device">
        <div class="x6-device-head">
          <div class="x6-dots"><i></i><i></i><i></i></div>
          <span class="x6-device-title">Fiche confidentielle</span>
        </div>
        <div class="x6-device-body">
          <div class="x6-device-row">
            <span class="x6-badge-private"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg> Non diffusé publiquement</span>
            <span class="x6-badge-compat">Compatibilité élevée</span>
          </div>
          <div class="x6-device-photo">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="1.2"><rect x="3" y="3" width="18" height="14" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
          </div>
          <div class="x6-device-name">Maison 4 pièces · Carnac (56)</div>
          <div class="x6-device-desc">Jardin clos, proche bourg, vie de famille. Photos visibles uniquement si le vendeur les partage.</div>
          <div class="x6-device-tags"><span>Près de la mer</span><span>Sans travaux</span><span>Projet qualifié</span></div>
          <div class="x6-device-consent">
            <div class="x6-consent-row"><span>Coordonnées vendeur</span><b>privées</b></div>
            <div class="x6-consent-row"><span>Coordonnées acheteur</span><b>privées</b></div>
            <div class="x6-consent-row"><span>Mise en relation</span><b>sur accord des deux côtés</b></div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>

<!-- v6 — CONTRASTE -->
<section class="s6" style="background:var(--white);">
  <div class="s6-wrap">
    <div class="s6-eyebrow">Pour être clair</div>
    <h2 class="s6-h2">Vous n'êtes pas sur un<br>portail d'annonces.</h2>
    <p class="s6-lead">Les portails ont leur utilité. Ici, la logique est inversée : on ne diffuse rien, on rapproche les bons projets. Sans dénigrer personne, voici ce qu'IMMATCH est — et ce qu'il n'est pas.</p>
    <div class="s6-contrast">
      <div class="s6-cbox is-not">
        <h3>IMMATCH n'est pas</h3>
        <div class="s6-cline"><span class="s6-ic">✕</span>Un portail où tout le monde voit les mêmes biens.</div>
        <div class="s6-cline"><span class="s6-ic">✕</span>Une marketplace ouverte à la sollicitation de masse.</div>
        <div class="s6-cline"><span class="s6-ic">✕</span>Un simple outil d'estimation immobilière.</div>
      </div>
      <div class="s6-cbox is-yes">
        <h3>IMMATCH permet</h3>
        <div class="s6-cline"><span class="s6-ic">✓</span>D'avancer hors annonces, avec un projet qualifié.</div>
        <div class="s6-cline"><span class="s6-ic">✓</span>De garder la main sur ce qui se partage, quand et avec qui.</div>
        <div class="s6-cline"><span class="s6-ic">✓</span>D'être accompagné par un professionnel, seulement si vous le demandez.</div>
      </div>
    </div>
  </div>
</section>

<!-- v6 — POUR QUI -->
<section class="s6" id="pour-qui" style="background:var(--white);">
  <div class="s6-wrap">
    <div class="s6-eyebrow">Pour qui ?</div>
    <h2 class="s6-h2">Pour les vendeurs discrets.<br><em>Pour les acheteurs précis.</em></h2>
    <p class="s6-lead">IMMATCH s'adresse aux projets qui demandent de la discrétion, de la qualification et du contrôle — pas une exposition automatique.</p>
    <div class="s6-who">
      <div class="s6-who-card is-seller">
        <span class="s6-who-tag">Vendeur</span>
        <h3>Tester l'intérêt réel,<br>sans exposer son bien partout.</h3>
        <p>Vous souhaitez vendre, mais pas forcément apparaître publiquement ni être sollicité par tout le marché.</p>
        <ul class="s6-who-list">
          <li>Votre bien reste hors annonces.</li>
          <li>Vous choisissez ce que vous partagez.</li>
          <li>Vous décidez si une mise en relation mérite d'aller plus loin.</li>
        </ul>
      </div>
      <div class="s6-who-card is-buyer">
        <span class="s6-who-tag">Acheteur</span>
        <h3>Recevoir uniquement<br>des opportunités compatibles.</h3>
        <p>Vous cherchez un bien précis, parfois introuvable sur les portails, sans perdre de temps à filtrer des annonces sans intérêt.</p>
        <ul class="s6-who-list">
          <li>Votre recherche est qualifiée selon vos vrais critères.</li>
          <li>Vous accédez à des biens qui ne sont pas forcément diffusés.</li>
          <li>Vous demandez le contact quand l'opportunité vous intéresse.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- v6 — COMMENT CA MARCHE + IMA -->
<section class="s6" id="process" style="background:var(--stone);">
  <div class="s6-wrap">
    <div class="s6-eyebrow">Comment ça marche</div>
    <h2 class="s6-h2">Un projet qualifié. Des compatibilités privées.<br><em>Une mise en relation choisie.</em></h2>
    <p class="s6-lead">Le matching reste le moteur, en coulisse. Ce que vous vivez, c'est un parcours lisible où chaque étape respecte votre accord.</p>
    <div class="s6-steps">
      <div class="s6-step"><div class="s6-step-num">01</div><h3>Vous décrivez votre projet</h3><p>Vente, achat ou recherche : vos critères, votre situation, et ce que vous acceptez de partager.</p></div>
      <div class="s6-step"><div class="s6-step-num">02</div><h3>IMMATCH identifie les compatibilités</h3><p>On rapproche les projets compatibles de votre zone, hors annonces, sans aucune diffusion publique.</p></div>
      <div class="s6-step"><div class="s6-step-num">03</div><h3>Vous décidez d'aller plus loin</h3><p>La mise en relation n'a lieu que sous condition d'accord réciproque. Vous ouvrez le contact, ou pas.</p></div>
      <div class="s6-step"><div class="s6-step-num">04</div><h3>Un professionnel, si nécessaire</h3><p>Vérifié avant référencement — Kbis, assurance, garanties. Jamais imposé : il n'intervient que sur votre demande, en cas de besoin réel.</p></div>
    </div>
    <div class="s6-ima">
      <div>
        <div class="s6-ima-head"><span class="dot">I</span><div><div class="s6-ima-name">IMA</div><div class="s6-ima-role">votre interlocutrice, dès le tout début</div></div></div>
        <h3>Elle s'intéresse à ce que<br>les murs ont vécu.<br><em>Pas à vos mètres carrés.</em></h3>
        <p>Dès la première étape, IMA prend le temps de vous écouter. Pas un formulaire de plus : des questions qui font remonter ce qui compte vraiment dans votre projet.</p>
        <p>C'est ce qui nous permet de ne vous proposer que ce qui correspond réellement à votre histoire.</p>
      </div>
      <div class="s6-ima-quote">
        <div class="q">“</div>
        <p>Vous pensiez remplir un questionnaire. IMA vous demande depuis combien de temps vous vivez là. Puis ce qui s'est passé de beau, ici. Sans vous en rendre compte, vous parlez de la cuisine refaite un été, du jardin, des enfants qui ont grandi. À la fin, vous avez raconté votre maison comme vous ne l'aviez jamais fait.</p>
        <div class="sig">L'expérience <b>IMA</b></div>
      </div>
    </div>
  </div>
</section>

<!-- v6 — CAS CONCRET -->
<section class="s6" style="background:var(--white);">
  <div class="s6-wrap">
    <div class="s6-eyebrow">Un cas concret</div>
    <h2 class="s6-h2">Marie cherchait. Jean ne diffusait pas.<br><em>IMMATCH les a rapprochés.</em></h2>
    <div class="s6-case">
      <div class="s6-case-card">
        <div class="s6-case-role" style="color:#185FA5;">Acheteuse</div>
        <div class="s6-case-name">Marie</div>
        <p>Cherche une maison 4 pièces à Carnac. Budget défini, projet de vie clair, prête à visiter.</p>
      </div>
      <div class="s6-case-mid">
        <div class="s6-case-badge">
          <strong>Compatibilité projet forte</strong>
          <span>Mise en relation uniquement après accord réciproque</span>
        </div>
      </div>
      <div class="s6-case-card">
        <div class="s6-case-role" style="color:#1D9E75;">Vendeur</div>
        <div class="s6-case-name">Jean</div>
        <p>Vend sa maison sans l'avoir mise en agence. Veut tester le marché avant de s'exposer.</p>
      </div>
    </div>
    <div class="s6-case-out">
      <p>Marie reçoit une fiche confidentielle avec les photos du bien. Elle demande la mise en relation. Jean accepte. Ils se parlent <b>directement</b> — sans annonce, sans intermédiaire imposé, sans avoir jamais exposé le bien publiquement — et, en relation directe, sans frais d'intermédiaire.</p>
    </div>
  </div>
</section>

<!-- v6 — CONFIANCE -->
<section class="s6" id="confiance" style="background:var(--stone);">
  <div class="s6-wrap s6-trust">
    <div>
      <div class="s6-eyebrow">Confiance</div>
      <h2 class="s6-h2" style="font-size:clamp(30px,3.6vw,46px);">Vos données vous appartiennent.<br><em>Vos décisions aussi.</em></h2>
      <p class="s6-lead">Cadre Estate Solutions a conçu IMMATCH sur un principe simple : vous gardez le contrôle de votre projet à chaque étape. Vous êtes accompagné si vous le souhaitez, seul si vous le préférez. IMMATCH ne décide jamais à votre place.</p>
    </div>
    <div class="s6-trust-items">
      <div class="s6-titem"><h4>Coordonnées protégées</h4><p>Vos coordonnées ne sont transmises que sous condition d'accord réciproque, lorsque vous et l'autre partie l'avez accepté.</p></div>
      <div class="s6-titem"><h4>Vos données ne sont pas un produit</h4><p>Cadre Estate Solutions ne vend pas vos données. Elles ne sont transmises qu'aux professionnels que vous sollicitez, et uniquement dans ce cadre.</p></div>
      <div class="s6-titem"><h4>Conformité RGPD</h4><p>Cadre Estate Solutions est responsable de traitement. Vos droits d'accès, de rectification et de suppression sont garantis.</p></div>
      <div class="s6-titem"><h4>Professionnels vérifiés</h4><p>Chaque partenaire est validé manuellement (Kbis, RCP, justificatifs). Il n'intervient qu'en cas de besoin réel et sur votre demande — jamais de sa propre initiative.</p></div>
    </div>
  </div>
</section>

<!-- v6 — FAQ -->
<section class="s6" style="background:var(--white);">
  <div class="s6-wrap" style="text-align:center;">
    <div class="s6-eyebrow" style="justify-content:center;">Questions fréquentes</div>
    <h2 class="s6-h2" style="margin:0 auto;text-align:center;">Ce qu'on nous demande<br><em>le plus souvent.</em></h2>
  </div>
  <div class="s6-faq">
    <details><summary>Pourquoi mon bien n'apparaît-il nulle part ?</summary><p>Parce que c'est le principe. Votre bien n'est pas diffusé publiquement : il est rapproché, en privé, des acheteurs dont le projet correspond au vôtre. Rien ne sort sans votre accord.</p></details>
    <details><summary>L'estimation est-elle obligatoire ?</summary><p>Non. L'estimation est un repère facultatif, basé sur les ventes réelles autour de vous. Le cœur d'IMMATCH, c'est votre projet : le décrire suffit pour démarrer.</p></details>
    <details><summary>Quand mes coordonnées sont-elles partagées ?</summary><p>Uniquement sous condition d'accord réciproque : lorsque vous et l'autre partie avez tous deux accepté la mise en relation. Jamais avant.</p></details>
    <details><summary>Suis-je engagé à quelque chose ?</summary><p>Non. Vous avancez à votre rythme et décidez à chaque étape, libre de poursuivre, de patienter ou de ne pas donner suite.</p></details>
    <details><summary>Et si je veux un professionnel ?</summary><p>Vous pouvez en solliciter un, et seulement si vous le demandez. Chaque partenaire est vérifié avant référencement (Kbis, assurance, garanties). Il n'intervient jamais de lui-même.</p></details>
    <details><summary>IMMATCH remplace-t-il une agence ?</summary><p>Non. IMMATCH n'est pas une agence : c'est un service de mise en relation confidentiel entre particuliers. Vous restez libre de solliciter un professionnel vérifié si vous le souhaitez, à votre seule demande.</p></details>
    <details><summary>Le matching est-il automatique ?</summary><p>Le rapprochement, oui ; la mise en relation, non. IMMATCH identifie les compatibilités en coulisse, mais rien ne se déclenche sans votre accord et celui de l'autre partie.</p></details>
    <details><summary>Puis-je aussi diffuser mon bien ailleurs ?</summary><p>Vous restez libre de le faire. Sachez seulement qu'un bien qui tarde à trouver preneur tient rarement au manque de visibilité : c'est presque toujours le prix. IMMATCH vous donne une lecture de la demande réelle pour ajuster avant d'aller plus loin. Et si vous diffusez en parallèle, le bien passe en complémentaire — son statut est indiqué, sans fermer la porte aux acheteurs déjà identifiés.</p></details>
  </div>
</section>

<section id="estimer" style="padding:100px 0;background:var(--white);">
  <div style="max-width:1160px;margin:0 auto;padding:0 40px;">

    <!-- Header -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;margin-bottom:64px;">
      <div>
        <div style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--teal);font-weight:500;display:flex;align-items:center;gap:10px;margin-bottom:20px;">
          <span style="display:block;width:24px;height:1px;background:var(--teal);"></span>
          Un repère avant de vous lancer
        </div>
        <h2 style="font-family:var(--serif);font-size:clamp(32px,3.5vw,52px);font-weight:300;line-height:1.1;margin-bottom:16px;">
          Besoin d'un repère<br><em style="font-style:italic;color:var(--teal);">avant de vendre ?</em>
        </h2>
        <p style="font-size:15px;color:var(--ink-soft);line-height:1.8;max-width:400px;">
          L'estimation vous donne une première indication, basée sur les ventes réelles autour de vous. Le cœur d'IMMATCH reste votre projet : le qualifier, le protéger, puis identifier les bonnes compatibilités.
        </p>
        <div style="display:flex;gap:24px;margin-top:32px;padding-top:24px;border-top:1px solid var(--stone-mid);">
          <div style="display:flex;flex-direction:column;gap:4px;">
            <span style="font-family:var(--serif);font-size:22px;font-weight:600;color:var(--teal);line-height:1;">DVF</span>
            <span style="font-size:11px;color:var(--ink-soft);letter-spacing:.04em;">Source officielle État</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px;">
            <span style="font-family:var(--serif);font-size:22px;font-weight:600;color:var(--teal);line-height:1;">100%</span>
            <span style="font-size:11px;color:var(--ink-soft);letter-spacing:.04em;">Gratuit & sans compte</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px;">
            <span style="font-family:var(--serif);font-size:22px;font-weight:600;color:var(--teal);line-height:1;">30s</span>
            <span style="font-size:11px;color:var(--ink-soft);letter-spacing:.04em;">Résultat immédiat</span>
          </div>
        </div>
      </div>

      <!-- Formulaire -->
      <div style="background:var(--stone);border-radius:24px;padding:40px;border:1px solid var(--stone-mid);">
        <div style="font-family:var(--serif);font-size:20px;font-weight:400;margin-bottom:28px;color:var(--ink);">
          Estimez votre bien
        </div>

        <!-- Adresse -->
        <div style="margin-bottom:20px;">
          <label style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);font-weight:500;display:block;margin-bottom:8px;">Adresse du bien</label>
          <div style="position:relative;">
            <input id="dvf-adresse" type="text" placeholder="12 rue du Marché, Vannes..."
              style="width:100%;border:1.5px solid var(--stone-mid);border-radius:12px;padding:13px 16px;font-family:var(--sans);font-size:14px;color:var(--ink);background:var(--white);transition:border-color .2s;outline:none;"
              onfocus="this.style.borderColor='var(--teal)'"
              onblur="this.style.borderColor='var(--stone-mid)'"
              oninput="dvfAdresseInput(this.value)"/>
            <div id="dvf-suggestions" style="display:none;position:absolute;top:100%;left:0;right:0;background:var(--white);border:1px solid var(--stone-mid);border-radius:12px;margin-top:4px;z-index:50;max-height:200px;overflow-y:auto;box-shadow:0 8px 24px rgba(26,26,24,.1);"></div>
          </div>
          <div id="dvf-coords" style="display:none;"></div>
        </div>

        <!-- Type de bien -->
        <div style="margin-bottom:20px;">
          <label style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);font-weight:500;display:block;margin-bottom:8px;">Type de bien</label>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
            <div class="dvf-type-btn" data-type="Appartement" onclick="selectType(this)"
              style="border:1.5px solid var(--stone-mid);border-radius:10px;padding:10px 14px;cursor:pointer;font-size:13px;color:var(--ink);background:var(--white);text-align:center;transition:all .2s;">
              Appartement
            </div>
            <div class="dvf-type-btn" data-type="Maison" onclick="selectType(this)"
              style="border:1.5px solid var(--stone-mid);border-radius:10px;padding:10px 14px;cursor:pointer;font-size:13px;color:var(--ink);background:var(--white);text-align:center;transition:all .2s;">
              Maison
            </div>
          </div>
        </div>

        <!-- Surface -->
        <div style="margin-bottom:28px;">
          <label style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);font-weight:500;display:block;margin-bottom:8px;">Surface habitable</label>
          <div style="display:flex;align-items:center;gap:12px;">
            <input id="dvf-surface" type="number" placeholder="85" min="10" max="2000"
              style="flex:1;border:1.5px solid var(--stone-mid);border-radius:12px;padding:13px 16px;font-family:var(--sans);font-size:14px;color:var(--ink);background:var(--white);transition:border-color .2s;outline:none;"
              onfocus="this.style.borderColor='var(--teal)'"
              onblur="this.style.borderColor='var(--stone-mid)'"/>
            <span style="font-size:14px;color:var(--ink-soft);white-space:nowrap;">m²</span>
          </div>
        </div>

        <!-- Bouton -->
        <button onclick="lancerEstimation()"
          style="width:100%;background:var(--teal);color:#fff;border:none;border-radius:100px;padding:15px 32px;font-family:var(--sans);font-size:14px;font-weight:500;cursor:pointer;transition:background .2s,transform .15s;letter-spacing:.03em;"
          onmouseover="this.style.background='var(--teal-deep)';this.style.transform='translateY(-1px)'"
          onmouseout="this.style.background='var(--teal)';this.style.transform='none'">
          Estimer gratuitement →
        </button>

        <!-- État loading -->
        <div id="dvf-loading" style="display:none;text-align:center;padding:20px 0;">
          <div style="font-size:13px;color:var(--ink-soft);font-style:italic;">Analyse des transactions DVF en cours...</div>
        </div>

        <!-- Résultat -->
        <div id="dvf-result" style="display:none;margin-top:24px;background:var(--white);border-radius:16px;padding:28px;border:1px solid var(--stone-mid);">
          <div style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);font-weight:500;margin-bottom:12px;">Estimation DVF</div>
          <div id="dvf-prix" style="font-family:var(--serif);font-size:36px;font-weight:600;color:var(--ink);line-height:1;margin-bottom:4px;"></div>
          <div id="dvf-prix-m2" style="font-size:13px;color:var(--ink-soft);margin-bottom:16px;"></div>
          <div id="dvf-fourchette" style="font-size:13px;color:var(--ink-soft);margin-bottom:20px;line-height:1.6;"></div>
          <div id="dvf-source" style="font-size:11px;color:var(--stone-dark);margin-bottom:24px;"></div>
          <div style="font-size:12px;color:var(--ink-soft);font-style:italic;line-height:1.65;margin-bottom:24px;">Un résultat brut, calculé sur les seules ventes réelles autour de vous — sans pondération ni correction. Il ne prétend pas tout dire&nbsp;: le vrai intérêt commence quand vous testez votre projet.</div>

          <!-- CTA après résultat -->
          <div style="background:var(--teal-pale);border-radius:12px;padding:20px;border:1px solid rgba(15,129,145,.15);">
            <div style="font-size:13px;color:var(--teal-deep);font-weight:500;margin-bottom:8px;">
              Votre bien vaut ce prix. Combien d'acheteurs compatibles existent déjà ?
            </div>
            <div style="font-size:12px;color:var(--ink-soft);margin-bottom:16px;line-height:1.5;">
              Créez votre projet confidentiel — vos données DVF sont déjà pré-remplies.
            </div>
            <button onclick="creerProjet()"
              style="width:100%;background:var(--teal);color:#fff;border:none;border-radius:100px;padding:12px 24px;font-family:var(--sans);font-size:13px;font-weight:500;cursor:pointer;transition:background .2s;"
              onmouseover="this.style.background='var(--teal-deep)'"
              onmouseout="this.style.background='var(--teal)'">
              Découvrir les acheteurs compatibles →
            </button>
          </div>
        </div>

        <!-- Erreur -->
        <div id="dvf-error" style="display:none;margin-top:16px;background:#fff5f5;border-radius:12px;padding:16px;border:1px solid #fecaca;">
          <div style="font-size:13px;color:#991b1b;" id="dvf-error-msg"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
// ============================================================
// ESTIMATEUR DVF — API Etalab officielle
// ============================================================

let dvfLat = null;
let dvfLon = null;
let dvfType = null;
let dvfSuggestTimer = null;

function selectType(el) {
  document.querySelectorAll('.dvf-type-btn').forEach(b => {
    b.style.borderColor = 'var(--stone-mid)';
    b.style.background = 'var(--white)';
    b.style.color = 'var(--ink)';
    b.style.fontWeight = '400';
  });
  el.style.borderColor = 'var(--teal)';
  el.style.background = 'var(--teal-pale)';
  el.style.color = 'var(--teal-deep)';
  el.style.fontWeight = '500';
  dvfType = el.dataset.type;
}

function dvfAdresseInput(val) {
  clearTimeout(dvfSuggestTimer);
  if (val.length < 4) {
    document.getElementById('dvf-suggestions').style.display = 'none';
    return;
  }
  dvfSuggestTimer = setTimeout(() => fetchSuggestions(val), 300);
}

async function fetchSuggestions(q) {
  try {
    const r = await fetch(`https://api-adresse.data.gouv.fr/search/?q=${encodeURIComponent(q)}&limit=5&type=housenumber`);
    const data = await r.json();
    const box = document.getElementById('dvf-suggestions');
    if (!data.features || data.features.length === 0) {
      box.style.display = 'none';
      return;
    }
    box.innerHTML = data.features.map(f => `
      <div onclick="selectAdresse(${f.geometry.coordinates[1]}, ${f.geometry.coordinates[0]}, '${f.properties.label.replace(/'/g, "\'")}' )"
        style="padding:12px 16px;cursor:pointer;font-size:13px;color:var(--ink);border-bottom:1px solid var(--stone-mid);transition:background .15s;"
        onmouseover="this.style.background='var(--teal-pale)'"
        onmouseout="this.style.background='transparent'">
        ${f.properties.label}
      </div>
    `).join('');
    box.style.display = 'block';
  } catch(e) {
    document.getElementById('dvf-suggestions').style.display = 'none';
  }
}

function selectAdresse(lat, lon, label) {
  dvfLat = lat;
  dvfLon = lon;
  document.getElementById('dvf-adresse').value = label;
  document.getElementById('dvf-suggestions').style.display = 'none';
}

async function lancerEstimation() {
  // Validations
  const surface = parseFloat(document.getElementById('dvf-surface').value);
  if (!dvfLat || !dvfLon) {
    afficherErreur('Merci de sélectionner une adresse dans la liste de suggestions.');
    return;
  }
  if (!dvfType) {
    afficherErreur('Merci de sélectionner le type de bien (Appartement ou Maison).');
    return;
  }
  if (!surface || surface < 10 || surface > 2000) {
    afficherErreur('Merci de renseigner une surface valide (entre 10 et 2 000 m²).');
    return;
  }

  // Reset
  document.getElementById('dvf-result').style.display = 'none';
  document.getElementById('dvf-error').style.display = 'none';
  document.getElementById('dvf-loading').style.display = 'block';

  try {
    // API DVF Etalab — rayon 1000m autour du point
    const url = `https://api.priximmobilier.etalab.gouv.fr/geojson?lat=${dvfLat}&lon=${dvfLon}&dist=1000&type=vente`;
    const r = await fetch(url);

    if (!r.ok) throw new Error('API DVF indisponible');
    const data = await r.json();

    if (!data.features || data.features.length === 0) {
      throw new Error('Aucune transaction trouvée dans un rayon de 1 km. Essayez une adresse plus centrale.');
    }

    // Filtrer par type de bien et surface ±40%
    const typeFilter = dvfType === 'Maison' ? 'Maison' : 'Appartement';
    const transactions = data.features.filter(f => {
      const p = f.properties;
      if (!p.type_local || !p.surface_reelle_bati) return false;
      if (!p.type_local.includes(typeFilter === 'Maison' ? 'Maison' : 'Appartement')) return false;
      const surf = parseFloat(p.surface_reelle_bati);
      return surf >= surface * 0.6 && surf <= surface * 1.4;
    });

    if (transactions.length < 3) {
      // Fallback : toutes transactions du même type sans filtre surface
      const fallback = data.features.filter(f => {
        const p = f.properties;
        return p.type_local && p.type_local.includes(typeFilter === 'Maison' ? 'Maison' : 'Appartement')
          && p.valeur_fonciere && p.surface_reelle_bati;
      });
      if (fallback.length < 2) {
        throw new Error('Pas assez de transactions similaires dans ce secteur. Essayez avec une autre adresse.');
      }
      afficherResultat(fallback, surface, true);
    } else {
      afficherResultat(transactions, surface, false);
    }

  } catch(e) {
    afficherErreur(e.message || "Erreur lors de la connexion à l'API DVF. Réessayez dans quelques instants.");
  } finally {
    document.getElementById('dvf-loading').style.display = 'none';
  }
}

function afficherResultat(transactions, surface, fallback) {
  // Calculer le prix au m²
  const prixM2List = transactions.map(f => {
    const p = f.properties;
    return parseFloat(p.valeur_fonciere) / parseFloat(p.surface_reelle_bati);
  }).filter(v => v > 500 && v < 50000); // Filtrer valeurs aberrantes

  if (prixM2List.length === 0) {
    afficherErreur('Données insuffisantes pour calculer une estimation fiable.');
    return;
  }

  // Médiane
  prixM2List.sort((a, b) => a - b);
  const mediane = prixM2List[Math.floor(prixM2List.length / 2)];
  const q1 = prixM2List[Math.floor(prixM2List.length * 0.25)];
  const q3 = prixM2List[Math.floor(prixM2List.length * 0.75)];

  const estimation = Math.round(mediane * surface);
  const bas = Math.round(q1 * surface);
  const haut = Math.round(q3 * surface);

  // Année la plus récente
  const annees = transactions.map(f => {
    const d = f.properties.date_mutation;
    return d ? d.substring(0, 4) : '';
  }).filter(Boolean).sort().reverse();
  const anneeRef = annees[0] || '2024';

  document.getElementById('dvf-prix').textContent = formatPrix(estimation) + ' €';
  document.getElementById('dvf-prix-m2').textContent = Math.round(mediane).toLocaleString('fr-FR') + ' €/m² médian';
  document.getElementById('dvf-fourchette').innerHTML =
    `Fourchette estimée : <strong>${formatPrix(bas)} €</strong> — <strong>${formatPrix(haut)} €</strong><br>` +
    `Basé sur ${prixM2List.length} transaction${prixM2List.length > 1 ? 's' : ''} similaire${prixM2List.length > 1 ? 's' : ''} dans un rayon de 1 km` +
    (fallback ? ' (surface élargie)' : '');
  document.getElementById('dvf-source').textContent =
    `Source : DVF Etalab — données officielles — dernière transaction analysée : ${anneeRef}`;

  document.getElementById('dvf-result').style.display = 'block';

  // Stocker pour pré-remplissage
  window._dvfData = {
    adresse: document.getElementById('dvf-adresse').value,
    type: dvfType,
    surface: surface,
    estimation: estimation,
    prixM2: Math.round(mediane)
  };
}

function formatPrix(n) {
  return n.toLocaleString('fr-FR');
}

function afficherErreur(msg) {
  document.getElementById('dvf-error-msg').textContent = msg;
  document.getElementById('dvf-error').style.display = 'block';
  document.getElementById('dvf-loading').style.display = 'none';
}

function creerProjet() {
  // Redirige vers le questionnaire avec données pré-remplies
  const d = window._dvfData;
  if (d) {
    const params = new URLSearchParams({
      adresse: d.adresse,
      type: d.type,
      surface: d.surface,
      estimation: d.estimation
    });
    window.location.href = '/creer-projet?' + params.toString();
  } else {
    window.location.href = '/creer-projet';
  }
}
</script>

<!-- v6 — BANDE MORBIHAN -->
<section class="s6" style="background:var(--white);">
  <div class="s6-wrap">
    <div class="s6-eyebrow">Notre terrain</div>
    <h2 class="s6-h2">Là où votre projet<br><em>prend racine.</em></h2>
    <p class="s6-lead">La mer, la forêt, la campagne, la ville. IMMATCH démarre sur un territoire qu'on connaît — le Morbihan — là où chaque bien porte une histoire.</p>
    <div class="s6-morb">
      <figure><img src="data:image/jpeg;base64," alt="La mer, Morbihan"><figcaption>La mer</figcaption></figure>
      <figure><img src="data:image/jpeg;base64," alt="La forêt, Morbihan"><figcaption>La forêt</figcaption></figure>
      <figure><img src="data:image/jpeg;base64," alt="La campagne, Morbihan"><figcaption>La campagne</figcaption></figure>
      <figure><img src="data:image/jpeg;base64," alt="La ville, Morbihan"><figcaption>La ville</figcaption></figure>
    </div>
  </div>
</section>

<!-- v6 — CTA FINAL (Morbihan fusionné) -->
<section class="s6" style="background:var(--stone);">
  <div class="s6-wrap">
    <div class="s6-cta-card">
      <div class="s6-cta-eyebrow"><i></i>Lancement · Morbihan (56)</div>
      <h2>Donnez du sens<br>à votre <em>projet immobilier.</em></h2>
      <p>Les premiers inscrits accèdent en priorité aux projets off-market de leur zone, avant l'ouverture au grand public. Simplement, et en toute discrétion.</p>
      <button class="s6-cta-btn">Décrivez votre projet →</button>
    </div>
  </div>
</section>

<!-- FOOTER -->
